{
  "name": "Carnet de Dépenses Chantier",
  "short_name": "Chantier",
  "description": "Suivi hors-ligne des dépenses de chantier, partageable entre plusieurs personnes.",
  "lang": "fr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f1ec",
  "theme_color": "#b8520b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [ { "name": "file", "accept": ["text/plain", ".txt", "application/json", ".json", "application/octet-stream"] } ]
    }
  }
}
